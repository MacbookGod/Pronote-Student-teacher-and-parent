{
  "name": "pronote-desktop",
  "version": "1.0.0",
  "description": "Custom Electron wrapper for PRONOTE",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg",
    "build:win": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dragonbeast.pronote",
    "productName": "PRONOTE-Desktop",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  }
}
