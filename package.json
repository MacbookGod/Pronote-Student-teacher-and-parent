{
  "name": "pronote-desktop",
  "version": "3.0.0",
  "description": "Production Standalone Multi-Profile Client for PRONOTE & ENT portals",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg",
    "build:win": "electron-builder --win nsis"
  },
  "keywords": ["pronote", "electron", "desktop"],
  "author": "MacbookGod",
  "license": "ISC",
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.macbookgod.pronote",
    "productName": "PRONOTE-Desktop",
    "electronVersion": "31.7.7",
    "npmRebuild": false,
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  }
}
