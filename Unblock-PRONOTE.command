clear echo "=============================================" echo " PRONOTE Desktop - Gatekeeper Unblocker " echo "=============================================" echo "" # Locate the standard Applications directory path APP_PATH="/Applications/PRONOTE-Desktop.app" if [ -d "$APP_PATH" ]; then echo "[*] Found application bundle. Stripping quarantine tags..." # Run the exact Homebrew method to drop internet quarantine bits sudo xattr -d com.apple.quarantine "$APP_PATH" 2>/dev/null sudo xattr -cr "$APP_PATH" echo "[✓] App successfully unblocked! You can now close this window and open PRONOTE." else echo "[X] Error: PRONOTE-Desktop.app not found in your Applications folder." echo " Please drag the app into your Applications folder first, then run this again." fi echo "" read -p "Press [Enter] to exit..."